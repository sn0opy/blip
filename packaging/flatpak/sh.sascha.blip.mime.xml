<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-xisf">
    <comment>XISF image</comment>
    <acronym>XISF</acronym>
    <expanded-acronym>Extensible Image Serialization Format</expanded-acronym>
    <glob pattern="*.xisf"/>
    <magic priority="50">
      <match type="string" offset="0" value="XISF0100"/>
    </magic>
  </mime-type>
</mime-info>
