{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "ts",
    "rootDirs": ["ts", "www"],
    "outDir": "www"
  },
  "include": ["ts"],
  "exclude": ["ts/worker.ts"]
}
